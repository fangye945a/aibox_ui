# GitHub Pages 演示构建
#
# 纯静态托管，没有后端，数据全部由 src/mock 在浏览器内产生。
# 与 .env 分开，确保正式接真机的构建不受影响。

# 启用纯前端 Mock（src/mock/index.ts 据此安装 axios adapter）
VITE_DEMO=1

# Vite 的 base：必须与仓库名一致
# 仓库为 https://github.com/<user>/aibox_ui，故为 /aibox_ui/
VITE_BASE_PATH=/aibox_ui/

# 登录页演示提示
VITE_MOCK_HINT="admin / 任意 8 位以上密码"

# 关闭 Vite 插件的 Mock（演示态用 src/mock 的 adapter，不用 dev server 插件）
VITE_MOCK=0

# 占位，演示态不发起真实请求
VITE_BASE_URL=""
