{
  "name": "zaioh-device-mmp-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "CT23/CT21B 设备工作台与 GitHub Pages 交互原型",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview:demo": "vite preview --mode demo",
    "build:workspace-demo": "npm ci --prefix zaiohdeviceworkspace && npm run build --prefix zaiohdeviceworkspace -- --mode pages --dest ../dist"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4"
  }
}
